# Copy to .env.local for local work. Never commit .env.local.
# For a production build, see .env.production.example.

# ---------------------------------------------------------------------------
# Page (build-time). Anything prefixed VITE_ is baked into the PUBLIC bundle.
# ---------------------------------------------------------------------------

# Which vote store the page talks to.
#   local - in-browser mock, DEMO DATA only. Votes never leave the device. (default)
#   api   - the real backend: the vote API in server/handler.ts.
VITE_STORAGE_ADAPTER=local

# Only needed when VITE_STORAGE_ADAPTER=api. The full address of the vote API.
#   GitHub Pages + Supabase:  https://<project>.supabase.co/functions/v1/vote-api
#   Local rehearsal:          http://localhost:54329/api
#   Netlify (same site):      /api
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Vote API (run-time). Set these where the API runs: Supabase secrets, or
# Netlify environment variables. NOT VITE_ variables, on purpose: they must
# never reach the browser. `npm run secrets` prints fresh values for the two secrets.
# ---------------------------------------------------------------------------

# Key for hashing voters' email addresses (HMAC-SHA256, mixed with the event id).
# 32+ random characters. New for every event. Delete it after the Top 10 tally
# is signed off.
# VOTER_HASH_SECRET=

# Supabase Edge Function only. How many entries, counting from the right of
# X-Forwarded-For, Supabase itself adds. Used ONLY for the IP address recorded in
# the confidential audit export; it never affects whether a vote counts. A bad
# value falls back to 1. Check it before launch (README, "Before launch", 4a).
# TRUSTED_PROXY_HOPS=1

# Admin view passcode. 12+ characters.
# ADMIN_PASSCODE=

# The site(s) allowed to call the API from a browser. Exact origins, comma-separated:
# scheme and host only, no path, no trailing slash, no wildcard.
# ALLOWED_ORIGINS=https://youtrip-marketing.github.io

# Netlify only. Inside a Supabase Edge Function these two are provided automatically.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
