# TEST SITE build that sends every vote to a Google Sheet (README, "Test votes
# into a Google Sheet"). Copy to .env.sheet-test (gitignored), fill in the
# address, then: npm run build:sheet-test
# `npm run check:deploy` refuses this build. It is never the real voting page.

VITE_STORAGE_ADAPTER=sheet
VITE_TEST_DEPLOY=1
# The Apps Script web app address from Deploy > New deployment. Ends in /exec.
VITE_SHEET_ENDPOINT=https://script.google.com/macros/s/PASTE-DEPLOYMENT-ID/exec
