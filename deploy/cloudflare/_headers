# Cloudflare Pages response headers for the IMC 4 voting site (copied into
# dist-prod-cf/ by `npm run build:prod:cf`; not used by the GitHub Pages build).
#
# GitHub Pages sends no custom headers. The page itself sets robots noindex and
# referrer no-referrer as meta tags; the first two lines repeat those as headers.
# No Content-Security-Policy, as on GitHub Pages: the page talks to Apps Script,
# googleusercontent (redirect + lh3 photos) and api.ipify.org, and a CSP here
# could block a vote on the day.
/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Vite content-hashes everything in assets/, so it can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
