# Copy to .env.production (gitignored). Read by `npm run build:prod:cf` and
# `npm run check:deploy`. Everything here ends up in the public page. None of
# it is a secret. The GitHub Actions workflow sets the same three values.
#
# Production vote store since 26 Oct 2026: Kelicia's private Google Sheet,
# through the Apps Script web app (apps-script/Code.gs). Since 6 Nov 2026 the
# page reaches it only through /api/vote (functions/api/vote.ts), which holds
# the Apps Script address and checks a Cloudflare Turnstile token on every vote.

VITE_STORAGE_ADAPTER=sheet
VITE_SHEET_ENDPOINT=/api/vote
# The Turnstile site key (public). Its secret is the Pages project's TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAF0mlSd9gNxDiH7N
# The Apps Script /exec address is NOT set here any more: it is the Pages
# project's SHEET_ENDPOINT variable (Settings > Variables and Secrets).
# Never set VITE_TEST_DEPLOY here: it adds the TEST SITE banner, and check:deploy refuses it.

# The Supabase API path (never stood up). Kept for reference:
# VITE_STORAGE_ADAPTER=api
# VITE_API_BASE_URL=https://<project>.supabase.co/functions/v1/vote-api
