# Copy to .env.production (gitignored) and fill in VITE_SHEET_ENDPOINT.
# Read by `npm run build:prod` and `npm run check:deploy`.
# Everything here ends up in the public page. None of it is a secret.
#
# Production vote store since 26 Oct 2026: Kelicia's private Google Sheet,
# through the Apps Script web app (apps-script/Code.gs). README, "Launch".

VITE_STORAGE_ADAPTER=sheet
# Deploy > New deployment > Web app in the sheet's Apps Script editor. Ends in /exec.
VITE_SHEET_ENDPOINT=https://script.google.com/macros/s/PASTE-DEPLOYMENT-ID/exec
# Never set VITE_TEST_DEPLOY here: it adds the TEST SITE banner, and check:deploy refuses it.

# The Supabase API path (never stood up). Kept for reference:
# VITE_STORAGE_ADAPTER=api
# VITE_API_BASE_URL=https://<project>.supabase.co/functions/v1/vote-api
